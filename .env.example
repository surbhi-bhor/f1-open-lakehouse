# Local-only defaults. Copy to .env (git ignores it). Never reuse these anywhere real.
S3_ACCESS_KEY=f1admin
S3_SECRET_KEY=f1admin-local-only
POSTGRES_USER=f1
POSTGRES_PASSWORD=f1-local-only
# Host-side addresses. Containers override PG_HOST, PG_PORT and S3_ENDPOINT in docker-compose.yml.
PG_HOST=localhost
PG_PORT=5433
S3_ENDPOINT=http://localhost:9000
# Pinned versions (verified to exist on 2026-10-30).
# MinIO is built from source (infra/minio/Dockerfile) by the minio-image workflow and published to GHCR:
# last official releases, pinned to commits.
MINIO_IMAGE=ghcr.io/surbhi-bhor/f1lake-minio
MINIO_RELEASE=RELEASE.2025-10-15T17-29-55Z
MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
MC_RELEASE=RELEASE.2025-08-13T08-35-41Z
MC_COMMIT=7394ce0dd2a80935aded936b09fa12cbb3cb8096
POSTGRES_IMAGE=postgres:16.15
SPARK_IMAGE=apache/spark:3.5.7-python3
ICEBERG_VERSION=1.12.0
PG_JDBC_VERSION=42.7.14
