# Local-only defaults. Copy to .env (git ignores it). Never reuse these anywhere real.
S3_ACCESS_KEY=f1admin
S3_SECRET_KEY=f1admin-local-only
POSTGRES_USER=f1
POSTGRES_PASSWORD=f1-local-only
# Host-side addresses. Containers override PG_HOST, PG_PORT and S3_ENDPOINT in docker-compose.yml.
PG_HOST=localhost
PG_PORT=5433
S3_ENDPOINT=http://localhost:8333
# Pinned versions (verified to exist on 2026-10-30). MinIO images are no longer published, so SeaweedFS serves S3.
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.48
POSTGRES_IMAGE=postgres:16.15
SPARK_IMAGE=apache/spark:3.5.7-python3
ICEBERG_VERSION=1.12.0
PG_JDBC_VERSION=42.7.14
